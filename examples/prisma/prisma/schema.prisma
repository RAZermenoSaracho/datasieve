// Minimal schema so these examples type-check against a real generated
// Prisma Client, the same way examples/query-language type-checks
// against the real @datasieve/query-language package. Not queried at
// build/typecheck time — see each example file.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  status    String
  age       Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}
