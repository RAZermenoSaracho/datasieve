{
  "name": "@razsdev/datasieve-core",
  "version": "0.1.0",
  "description": "The DataSieve query engine: adapter contracts, the execution pipeline, plugins, and the standardized response contract.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "RAZermenoSaracho",
    "url": "https://github.com/RAZermenoSaracho"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/RAZermenoSaracho/datasieve/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAZermenoSaracho/datasieve.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/RAZermenoSaracho/datasieve/issues"
  },
  "keywords": [
    "datasieve",
    "query-engine",
    "adapter",
    "plugins",
    "filtering",
    "sorting",
    "pagination",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@razsdev/datasieve-query-language": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
