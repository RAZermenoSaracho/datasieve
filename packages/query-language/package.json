{
  "name": "@datasieve/query-language",
  "version": "0.1.0",
  "description": "DSQL — the database-agnostic query language at the core of DataSieve.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://github.com/RAZermenoSaracho/datasieve/tree/main/packages/query-language#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAZermenoSaracho/datasieve.git",
    "directory": "packages/query-language"
  },
  "bugs": {
    "url": "https://github.com/RAZermenoSaracho/datasieve/issues"
  },
  "keywords": [
    "datasieve",
    "query",
    "query-language",
    "dsql",
    "filtering",
    "sorting",
    "pagination",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
